    }}
  ],
  "functional_requirements": ["Requirement 1"],
  "non_functional_requirements": ["Requirement 1"],
  "overall_observations": ["Observation 1"]
}}

If a category has no findings, return an empty array.
Do not invent evidence or claim an issue exists without support.
Do not silently resolve conflicting stakeholder intentions.

REQUIREMENTS:
<requirements>
{data.requirements}
</requirements>
"""

    try:
        response = client.models.generate_content(
            model=GEMINI_MODEL,
            contents=prompt
        )

        result_text = (response.text or "").strip()

        if result_text.startswith("```"):
            result_text = result_text.split("\n", 1)[-1]
            if result_text.endswith("```"):
                result_text = result_text[:-3].strip()

        result = json.loads(result_text)

        return {
            "status": "success",
            "user": user["email"],
            "analysis": result
        }

    except json.JSONDecodeError:
        raise HTTPException(
            status_code=502,
            detail="AI returned an invalid response. Please retry."
        )
    except Exception:
        raise HTTPException(
            status_code=502,
