      "suggestion": "Resolution to consider"
    }}
  ],
  "duplicates": [
    {{
      "requirements": ["Statement 1", "Statement 2"],
      "issue": "Explanation"
    }}
  ],
  "missing_information": [
    {{
      "topic": "Information needed",
      "reason": "Why it matters",
      "question": "Question for stakeholder"
    }}
  ],
  "dependencies": [
    {{
      "requirement": "Requirement",
      "depends_on": "Related requirement",
      "reason": "Explanation"
    }}
  ],
  "improved_requirements": [
    {{
      "original": "Original requirement",
