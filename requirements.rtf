import streamlit as st
import requests

# APP CONFIGURATION
st.set_page_config(
    page_title="NxT AI",
    page_icon="🤖",
    layout="centered"
)

OLLAMA_URL = "http://localhost:11434/api/chat"
MODEL = "qwen2.5:1.5b"

# SESSION STATE
if "messages" not in st.session_state:
    st.session_state.messages = []

# CUSTOM UI
st.markdown("""
<style>
.stApp {
    background: linear-gradient(135deg, #07152f, #102d59);
    color: white;
}
h1, h2, h3, p, label {
    color: white !important;
}
.stChatMessage {
    background-color: rgba(255,255,255,0.07);
    border-radius: 15px;
    padding: 12px;
}
</style>
""", unsafe_allow_html=True)

# HEADER
st.title("🤖 NxT AI")
st.caption("Offline On-Device Artificial Intelligence")
st.success("🔒 Your prompts are processed by a local AI model.")

# SIDEBAR
with st.sidebar:
    st.title("⚙️ Settings")
    st.write("Model: Qwen 2.5 1.5B")
    st.write("Mode: Local AI")
    st.write("Internet: Not required after setup")

    if st.button("🗑️ Clear Chat"):
        st.session_state.messages = []
        st.rerun()

    st.divider()
    st.caption("NxT AI | Offline Intelligence")

# DISPLAY CHAT HISTORY
for msg in st.session_state.messages:
    with st.chat_message(msg["role"]):
        st.markdown(msg["content"])

# CHAT INPUT
prompt = st.chat_input("Ask NxT AI anything...")

if prompt:
    st.session_state.messages.append({
        "role": "user",
        "content": prompt
    })

    with st.chat_message("user"):
        st.markdown(prompt)

    with st.chat_message("assistant"):
        response_box = st.empty()

        try:
            payload = {
                "model": MODEL,
                "messages": [
                    {
                        "role": "system",
                        "content": (
                            "You are NxT AI, a helpful offline "
                            "AI assistant. Give clear, accurate "
                            "and concise answers."
                        )
                    },
                    *st.session_state.messages
                ],
                "stream": False,
                "options": {
                    "temperature": 0.7
                }
            }

            response = requests.post(
                OLLAMA_URL,
                json=payload,
                timeout=300
            )
            response.raise_for_status()

            answer = response.json()["message"]["content"]
            response_box.markdown(answer)

            st.session_state.messages.append({
                "role": "assistant",
                "content": answer
            })

        except requests.exceptions.ConnectionError:
            answer = (
                "⚠️ Cannot connect to Ollama. "
                "Please start Ollama and try again."
            )
            response_box.error(answer)

        except requests.exceptions.Timeout:
            answer = "⚠️ The model took too long to respond."
            response_box.error(answer)

        except Exception as e:
            answer = f"⚠️ Error: {e}"
            response_box.error(answer)
