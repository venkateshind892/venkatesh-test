]

with st.container(border=True):
    st.markdown(
        "<h2 style='text-align:center;margin-bottom:25px'>"
        "What would you like to explore?</h2>",
        unsafe_allow_html=True
    )

    for start in (0, 4):
        cols = st.columns(4)

        for col, (label, emoji) in zip(
            cols, APP_ITEMS[start:start + 4]
        ):
            with col:
                st.markdown(
                    f'<div class="app-icon">{emoji}</div>'
                    f'<div class="tile-label">{label}</div>',
                    unsafe_allow_html=True
                )

                if st.button(
                    "Open",
                    key=f"nav_{label}",
                    use_container_width=True
                ):
                    st.session_state.page = label
                    st.rerun()

    st.write("")
    chat_col, custom_col = st.columns(2)

    with chat_col:
        if st.button(
            "✦ Start Conversation",
            use_container_width=True
        ):
            st.session_state.page = "Chat"
            st.rerun()

    with custom_col:
        if st.button(
            "🎨 Customize Character",
            use_container_width=True
        ):
            st.session_state.page = "Character Studio"
            st.rerun()

# ==========================================
# PAGE ROUTER
# ==========================================

page = st.session_state.page

st.write("")

if page == "Chat":
    st.markdown("## ✦ Chat with " + safe_name)

    for msg in st.session_state.messages:
        with st.chat_message(
            msg["role"],
            avatar=(
                st.session_state.avatar
                if msg["role"] == "assistant" else "🧑"
            )
        ):
            st.markdown(msg["content"])

    prompt = st.chat_input("Ask your AI anything...")

    if prompt:
        st.session_state.messages.append({
            "role": "user",
            "content": prompt
        })

        with st.chat_message("user", avatar="🧑"):
            st.markdown(prompt)

        personality = (
            st.session_state.custom_prompt
            or f"Act as a {st.session_state.personality} assistant."
        )

        system_prompt = f"""
You are {safe_name}, a personal AI companion.
Personality: {st.session_state.personality}
Mood: {st.session_state.mood}
Instructions: {personality}
Respond naturally and helpfully.
"""

        with st.chat_message(
            "assistant",
            avatar=st.session_state.avatar
        ):
            try:
                with st.spinner("Thinking..."):
                    response = requests.post(
                        f"{OLLAMA_URL}/api/chat",
                        json={
                            "model": st.session_state.model,
                            "stream": False,
                            "messages": [
                                {
                                    "role": "system",
                                    "content": system_prompt
                                }
                            ] + st.session_state.messages[-12:]
                        },
                        timeout=180
                    )
                    response.raise_for_status()
                    answer = response.json()["message"]["content"]
                    st.markdown(answer)

                st.session_state.messages.append({
                    "role": "assistant",
                    "content": answer
                })

                st.session_state.history.append(prompt)

            except requests.RequestException as e:
                st.error(f"Local AI connection error: {e}")

        st.rerun()

elif page == "Character Studio":
    st.markdown("## 🎨 Character Studio")

    with st.container(border=True):
        st.markdown(
